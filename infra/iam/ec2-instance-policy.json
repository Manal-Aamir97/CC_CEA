{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAppSecretsFromParameterStore",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*:*:parameter/expense-tracker/*"
    },
    {
      "Sid": "ReceiptObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::expense-receipts-985882743436/receipts/*"
    },
    {
      "Sid": "ShipContainerLogsToCloudWatch",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/expense-tracker",
        "arn:aws:logs:*:*:log-group:/expense-tracker:*"
      ]
    }
  ]
}
